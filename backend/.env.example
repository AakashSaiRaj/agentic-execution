# Native (non-container) local development configuration.
# Copy to `.env` inside the backend/ directory: cp .env.example .env

# SQLite by default (zero setup). For Postgres use e.g.:
#   DATABASE_URL=postgresql+psycopg2://agent:agent@localhost:5432/agent_platform
DATABASE_URL=sqlite:///./app.db

# LLM provider: mock | openai | anthropic  (mock needs no API key)
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Planner produces between MIN and MAX subtasks.
PLANNER_MIN_TASKS=2
PLANNER_MAX_TASKS=5

# Execution mode (Phase 2):
#   inline -> plan + run sequentially in-process (no Redis needed)
#   queue  -> enqueue jobs to Redis; run `python -m app.worker` separately
EXECUTION_MODE=inline
REDIS_URL=redis://localhost:6379/0
WORKER_CONCURRENCY=4

# Reliability (Phase 3)
TASK_MAX_RETRIES=3
TASK_TIMEOUT_SECONDS=30
RETRY_BACKOFF_BASE_SECONDS=1.0
RETRY_BACKOFF_MAX_SECONDS=30
RETRY_BACKOFF_JITTER=true
TASK_LEASE_SECONDS=90
LOG_FORMAT=text  # text | json

# Tools + observability (Phase 4)
TOOLS_ENABLED=true
TOOL_TIMEOUT_SECONDS=10
AGENT_MAX_TOOL_ITERATIONS=3
FETCH_MAX_BYTES=20000

LOG_LEVEL=INFO
CORS_ORIGINS=*

# Only needed for real providers:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
