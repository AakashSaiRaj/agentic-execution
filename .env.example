# Environment overrides for the compose stack. Copy to `.env` and edit as needed.
# The default provider is "mock" and requires no API keys.

LLM_PROVIDER=mock
LLM_MODEL=mock-model
LOG_LEVEL=INFO

# Phase 2: number of consumer threads per worker container.
WORKER_CONCURRENCY=4

# Phase 3: reliability tuning.
TASK_MAX_RETRIES=3
TASK_TIMEOUT_SECONDS=30
LOG_FORMAT=text

# Phase 4: tools.
TOOLS_ENABLED=true
TOOL_TIMEOUT_SECONDS=10
AGENT_MAX_TOOL_ITERATIONS=3

# Required only when LLM_PROVIDER is set to a real provider:
#   LLM_PROVIDER=openai   LLM_MODEL=gpt-4o-mini      OPENAI_API_KEY=sk-...
#   LLM_PROVIDER=anthropic LLM_MODEL=claude-3-5-sonnet-latest ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
